# Скопируйте файл в .env и заполните локальные значения.
# Файл .env исключён из Git.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Groq будет использоваться на будущем этапе генерации, не для embeddings.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Параметры Hybrid Search: два независимых канала → RRF → итоговый контекст
VECTOR_TOP_N=8
BM25_TOP_N=8
FINAL_TOP_K=5
RRF_K=60

